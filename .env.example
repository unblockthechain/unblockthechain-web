# Public URL of your audit intake form (opens in a new tab).
# Prefer committing lib/audit-form-url.ts via: npm run create:audit-form
# Or set manually:
#   Typeform:   https://form.typeform.com/to/xxxxxxxx
#   Tally:      https://tally.so/r/xxxxxx
NEXT_PUBLIC_AUDIT_FORM_URL=

# Canonical origin for sitemap, robots, OG URLs (no trailing slash).
# Default in code is https://unblockthechain.com
# NEXT_PUBLIC_SITE_URL=https://unblockthechain.com

# Open-source analytics (use one provider). Plausible: https://plausible.io (self-host: set SCRIPT_SRC to your instance).
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=unblockthechain.com
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=https://plausible.io/js/script.js

# Umami alternative: https://umami.is
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://your-umami.example.com/script.js

# Only for scripts/create-typeform-audit.mjs (never commit real tokens)
# TYPEFORM_ACCESS_TOKEN=
